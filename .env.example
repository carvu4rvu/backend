# PostgreSQL — use Supabase Transaction Pooler (NOT direct db.*.supabase.co)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase REST + Storage (HTTPS)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resilience tuning (optional)
SUPABASE_FETCH_TIMEOUT_MS=45000
SUPABASE_FETCH_RETRIES=3
SUPABASE_FETCH_RETRY_DELAY_MS=1000
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# SQL observability (optional)
# SQL_SLOW_MS=200
# SQL_LOG=all

# If ConnectTimeoutError mentions IPv6, prefer IPv4 first (either works):
# SUPABASE_PREFER_IPV4=true
# NODE_OPTIONS=--dns-result-order=ipv4first
